---
import EmbedLayout from '../../layouts/EmbedLayout.astro';
import { CALCULATORS } from '../../data/calculators';
import { EN_CALC_COMPONENTS } from '../../data/calc-components';

export function getStaticPaths() {
  return CALCULATORS.map((calc) => ({ params: { slug: calc.slug }, props: { calc } }));
}

const { calc } = Astro.props;
const CalcWidget = EN_CALC_COMPONENTS[calc.calcType];
const calcUrl = `https://simplifycalculator.com/calculators/${calc.slug}/`;
---

<EmbedLayout title={calc.title} calcUrl={calcUrl} lang="en">
  <div class="calc-card">
    <div class="calc-card-header">{calc.shortTitle}</div>
    <div class="calc-card-body">
      <CalcWidget />
    </div>
  </div>
</EmbedLayout>

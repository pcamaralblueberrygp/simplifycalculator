---
import EmbedCode from '../../components/EmbedCode.astro';
import { EN_CALC_COMPONENTS } from '../../data/calc-components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CALCULATORS, type CalcType } from '../../data/calculators';


export function getStaticPaths() {
  return CALCULATORS.map((calc) => ({
    params: { slug: calc.slug },
    props: { calc },
  }));
}

const componentMap = EN_CALC_COMPONENTS;

const { calc } = Astro.props;
const CalcWidget = componentMap[calc.calcType];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [...calc.faqs, ...(calc.workedExamples ?? [])].map((faq: { q: string; a: string }) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<BaseLayout
  title={calc.title}
  description={calc.metaDescription}
  path={`/calculators/${calc.slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- LP Header -->
  <div class="lp-header">
    <div class="container">
      <nav class="breadcrumbs">
        <a href="/">All calculators</a>
        <span>›</span>
        <span>{calc.category}</span>
        <span>›</span>
        <span>{calc.shortTitle}</span>
      </nav>
      <div class="eyebrow">{calc.category}</div>
      <h1>{calc.title}</h1>
      <p class="lp-intro">{calc.intro}</p>
    </div>
  </div>

  <!-- LP Body -->
  <div class="lp-body">
    <div class="container">

      <!-- Calculator widget -->
      <div class="calc-card">
        <div class="calc-card-header">{calc.shortTitle}</div>
        <div class="calc-card-body">
          <CalcWidget />
        </div>
      </div>

      <!-- How it works -->
      <div class="lp-section-label">How it works</div>
      <h2>Formula & methodology</h2>
      {calc.formulaExplanation.split('\n\n').map((p: string) => <p>{p}</p>)}
      {calc.formulaSource && (
        <p class="formula-source">
          Source: <a href={calc.formulaSource.url} target="_blank" rel="noopener noreferrer">{calc.formulaSource.label}</a>
        </p>
      )}

      <!-- Example -->
      <div class="lp-section-label" style="margin-top: 32px">Example</div>
      <h2>Worked example</h2>
      <p>{calc.example}</p>

      <!-- FAQ -->
      <div class="lp-section-label" style="margin-top: 32px">FAQ</div>
      <h2>Frequently asked questions</h2>
      <dl class="lp-faq">
        {calc.faqs.map((faq: { q: string; a: string }) => (
          <>
            <dt>{faq.q}</dt>
            <dd>{faq.a}</dd>
          </>
        ))}
      </dl>

      {calc.workedExamples && calc.workedExamples.length > 0 && (
        <>
          <div class="lp-section-label" style="margin-top: 32px">Worked examples</div>
          <h2>Worked examples, step by step</h2>
          {calc.workedExamples.map((ex: { q: string; a: string }) => (
            <>
              <h3>{ex.q}</h3>
              <p>{ex.a}</p>
            </>
          ))}
        </>
      )}

      {calc.tips && calc.tips.length > 0 && (
        <>
          <div class="lp-section-label" style="margin-top: 32px">Tips</div>
          <h2>Practical tips</h2>
          <ul class="lp-tips">
            {calc.tips.map((tip: string) => <li>{tip}</li>)}
          </ul>
        </>
      )}

      <EmbedCode
        title={calc.title}
        embedUrl={`https://simplifycalculator.com/embed/${calc.slug}/`}
        calcUrl={`https://simplifycalculator.com/calculators/${calc.slug}/`}
        lang="en"
      />

      <p class="disclaimer">
        Results are estimates for general informational purposes only and do not constitute
        financial, tax, or legal advice. Always confirm important figures with a qualified
        professional or your lender before making a financial decision.
      </p>
    </div>
  </div>
</BaseLayout>
